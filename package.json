{
  "name": "pdf-linter",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "compile-textlint": "textlint-script-compiler --metadataName dev --metadataNamespace \"https://example.com\" --metadataHomepage \"https://example.com\" --mode development --output-dir public",
    "lint": "biome check --fix --unsafe .",
    "lintcheck": "biome lint .",
    "fmt": "biome format --write .",
    "fmtcheck": "biome format .",
    "typecheck": "tsc",
    "predev": "node --run compile-textlint",
    "dev": "vite",
    "prebuild": "node --run compile-textlint",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pretest:browser": "node --run compile-textlint",
    "test:browser": "vitest --config=vitest.browser.config.mts"
  },
  "dependencies": {
    "@axe-core/react": "^4.13.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "jotai": "^3.0.0",
    "pdfjs-dist": "~6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@textlint/script-compiler": "^0.18.5",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.1",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-japanese": "^10.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  }
}
